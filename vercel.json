{
  "buildCommand": "npx expo export -p web",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    { "source": "/mobile-preview", "destination": "/mobile-preview.html" },
    { "source": "/mobile-preview.html", "destination": "/mobile-preview.html" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!_expo|assets|favicon.ico|mobile-preview.html).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron-reminders", "schedule": "0 0 * * *" },
    { "path": "/api/cleanup-storage-media", "schedule": "0 13 1 * *" }
  ]
}
